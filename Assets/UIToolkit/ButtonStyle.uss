:root {
}

.ButtonStyle {
    height: 112px;
    width: 570px;
    align-self: center;
    top: 125px;
    font-size: 60px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    background-color: rgb(27, 27, 27);
    border-top-left-radius: 25px;
    border-bottom-left-radius: 25px;
    border-bottom-right-radius: 25px;
    border-top-right-radius: 25px;
    transition-duration: 0.2s;
}

.ButtonStyle:hover {
    scale: 1.1 1.1;
}

.victory {
    position: absolute;
    left: 50%; top: 40%;
    width: 500px;
    translate: -50% 0;
    padding: 24px;
    background-color: rgb(20, 24, 36);
    border-radius: 8px;
    border-width: 2px;
    border-color: #ffd84a;
}
.victory-title { font-size: 30px; color: white; -unity-text-align: middle-center; margin-bottom: 10px; }
.victory-winner { font-size: 26px; color: #ffd84a; -unity-font-style: bold; -unity-text-align: middle-center; margin-bottom: 16px; }