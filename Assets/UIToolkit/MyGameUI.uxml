<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UIToolkit/ButtonStyle.uss?fileID=7433441132597879392&amp;guid=1f1157271424e0f42aeab47b812abc4c&amp;type=3#ButtonStyle"/>
    <Style src="project://database/Assets/UIToolkit/ScoreboardStyle.uss?fileID=7433441132597879392&amp;guid=b9f435f6ffe21e241b7a51da9b2b4d4b&amp;type=3#ScoreboardStyle"/>
    <Style src="project://database/Assets/UIToolkit/WaitingRoomPanel.uss?fileID=7433441132597879392&amp;guid=924c211dffe82c9478752bfb9f7bebe4&amp;type=3#WaitingRoomPanel"/>
    <ui:VisualElement name="MainMenuPanel" style="flex-grow: 1; background-image: none; display: none; overflow: visible;">
        <ui:Label text="MENU" name="Menu" style="font-size: 125px; -unity-text-align: upper-center; color: rgb(255, 255, 255); -unity-font-style: bold; -unity-text-outline-width: 4px; -unity-text-outline-color: rgb(0, 0, 0); text-shadow: 5px 5px 5px rgb(0, 0, 0); top: 0; margin-top: 100px;"/>
        <ui:Button text="PLAY" name="PlayButton" class="ButtonStyle" style="top: 150px;"/>
        <ui:Button text="OPCIONES" name="SettingsButton" class="ButtonStyle" style="top: 180px;"/>
        <ui:Button text="SALIR" name="QuitButton" class="ButtonStyle" style="top: 210px;"/>
    </ui:VisualElement>
    <ui:VisualElement name="SettingPanel" enabled="true" style="flex-grow: 1; background-image: none; justify-content: flex-start; align-self: auto; align-content: flex-start; display: none;">
        <ui:Label text="OPCIONES" name="Titulo" style="font-size: 125px; -unity-text-align: upper-center; color: rgb(255, 255, 255); -unity-font-style: bold; -unity-text-outline-width: 4px; -unity-text-outline-color: rgb(0, 0, 0); text-shadow: 5px 5px 5px rgb(0, 0, 0); top: 0; margin-top: 100px;"/>
        <ui:Label text="VOLUMEN" name="VolumenLabel" style="font-size: 70px; text-shadow: 0 0 0 rgb(0, 0, 0); -unity-text-outline-color: rgb(0, 0, 0); color: rgb(255, 255, 255); -unity-text-align: upper-center; top: 150px;"/>
        <ui:Slider label="" value="50" high-value="100" name="VolumenSlider" fill="true" show-input-field="false" inverted="false" enabled="true" view-data-key="" focusable="true" style="-unity-text-align: upper-center; top: 230px; width: 801px; left: auto; display: flex; position: relative; height: 41px; border-left-width: 0; align-content: flex-start; transform-origin: center; transition-duration: 0s; align-self: center;"/>
        <ui:Button text="ATRAS" name="BackButton" class="ButtonStyle" style="top: 515px; bottom: auto;"/>
        <ui:DropdownField label="ASTEROIDES" choices="0,100,500,1000,2500" index="0" name="AsteroideSetting" style="text-shadow: 0 0 0 rgb(0, 0, 0); color: rgb(255, 255, 255); font-size: 50px; height: 82px; width: 550px; left: 704px; top: 188px;"/>
    </ui:VisualElement>
    <ui:VisualElement name="MainLobbyPanel" enabled="true" style="flex-grow: 1; background-image: none; display: flex;">
        <ui:TextField label="" placeholder-text="Ingrese su nombre" name="PlayerNameInput" max-length="16" style="top: 323px; align-self: center; width: 570px; margin-left: 0; background-color: rgb(27, 27, 27); -unity-background-image-tint-color: rgb(255, 255, 255); border-top-left-radius: 2px; border-top-right-radius: 2px; border-bottom-left-radius: 2px; border-bottom-right-radius: 2px; color: rgb(0, 0, 0); font-size: 35px; -unity-text-outline-color: rgb(255, 255, 255); overflow: visible; margin-top: -135px; align-content: auto; margin-right: 0; margin-bottom: 0;"/>
        <ui:Button text="INICIAR HOST" name="IniciarHostButton" selectable="false" focusable="false" enabled="true" class="ButtonStyle" style="top: 400px; left: auto;"/>
        <ui:Button text="INICIAR CLIENTE" name="IniciarClienteButton" focusable="true" class="ButtonStyle" style="top: 570px; left: auto; visibility: visible; display: flex;"/>
        <ui:TextField label="" placeholder-text="INGRESE EL CODIGO" name="JoinCodeInput" style="height: 68px; width: 634px; font-size: 35px; -unity-text-align: upper-left; white-space: nowrap; text-overflow: clip; -unity-background-image-tint-color: rgb(255, 255, 255); background-color: rgb(27, 27, 27); transform-origin: center; left: auto; align-self: center; align-content: flex-start; top: 615px; color: rgb(0, 0, 0); -unity-font-style: bold; -unity-text-outline-color: rgb(255, 255, 255);"/>
    </ui:VisualElement>
    <ui:VisualElement name="PausePanel" style="flex-grow: 1; display: none; background-color: rgba(0, 0, 0, 0);">
        <ui:Label text="CODIGO" name="PauseJoinCodeLabel" style="font-size: 40px; width: 391px; background-color: rgba(255, 255, 255, 0.498); display: flex; -unity-font-style: bold;"/>
        <ui:Button text="REANUDAR" name="ReanudarButton" class="ButtonStyle" style="top: 316px;"/>
        <ui:Button text="DESCONECTAR" name="DisconnectButton" class="ButtonStyle" style="top: 427px;"/>
    </ui:VisualElement>
    <ui:VisualElement name="ScoreboardPanel" class="scoreboard" style="flex-grow: 1; display: none; background-color: rgba(20, 24, 36, 0.863); border-top-width: 2px; border-left-color: rgb(90, 110, 160); border-right-color: rgb(90, 110, 160); border-top-color: rgb(90, 110, 160); border-bottom-color: rgb(90, 110, 160); border-bottom-width: 2px; border-right-width: 2px; border-left-width: 2px;">
        <ui:VisualElement class="sb-row sb-header">
            <ui:Label text="Jugador" class="sb-name"/>
            <ui:Label text="Kills" class="sb-score"/>
            <ui:Label text="Deaths" class="sb-score"/>
        </ui:VisualElement>
        <ui:ScrollView name="ScoreboardList"/>
    </ui:VisualElement>
    <ui:VisualElement name="WaitingRoomPanel" class="room" style="flex-grow: 1; display: none;">
        <ui:VisualElement class="room-code-box" style="flex-grow: 1;">
            <ui:Label text="Código: ------" name="RoomCodeLabel" class="room-code"/>
            <ui:Button text="Copiar" name="CopyCodeButton" class="room-btn"/>
        </ui:VisualElement>
        <ui:Label text="SALA DE ESPERA" class="room-title"/>
        <ui:Label text="Jugadores: 0" name="RoomCountLabel" class="room-count"/>
        <ui:ScrollView name="RoomPlayerList" class="room-list"/>
        <ui:Label text="Esperando que el anfitrión inicie la partida..." name="RoomWaitingLabel" class="room-waiting"/>
        <ui:Button text="INICIAR PARTIDA" name="StartGameButton" class="room-btn room-start"/>
        <ui:Button text="Salir" name="LeaveRoomButton" class="room-btn"/>
    </ui:VisualElement>
</ui:UXML>
