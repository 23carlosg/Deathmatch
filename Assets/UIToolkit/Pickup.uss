.pickup-prompt {
    position: absolute;
    left: 50%; bottom: 25%;
    translate: -50% 0;
    flex-direction: row;
    align-items: center;
    padding: 8px 14px;
    background-color: rgba(20, 24, 36, 0.85);
    border-radius: 8px;
    border-width: 2px;
    border-color: rgb(90, 110, 160);
}
.pickup-key {
    width: 32px; height: 32px;
    margin-right: 10px;
    background-color: white;
    color: black;
    border-radius: 6px;
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
.pickup-text { color: white; font-size: 18px; }